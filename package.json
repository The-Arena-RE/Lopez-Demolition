{
  "name": "lopez-demolition-website",
  "version": "1.0.0",
  "private": true,
  "description": "Lopez Demolition Company website — static, phone-first, no dependencies.",
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "serve": "npx --yes serve public -l 4173",
    "dev": "node src/build.mjs && npx wrangler dev",
    "deploy": "node src/build.mjs && npx wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": { "node": ">=18" }
}
