{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lopez-demolition",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Run the Worker on every request so www.lopezdemo.com can redirect to lopezdemo.com.
    "run_worker_first": true
  },
  // Attaches the site to the domain already in this Cloudflare account.
  // Cloudflare creates the DNS records on deploy. Remove any existing A/AAAA/CNAME
  // records for these hostnames first, or the deploy will report a conflict.
  "routes": [
    { "pattern": "lopezdemo.com", "custom_domain": true },
    { "pattern": "www.lopezdemo.com", "custom_domain": true }
  ],
  // MAINTENANCE MODE: "true" = visitors only see the "coming soon" page.
  // Set to "false" and push to launch the full site.
  // Preview the real site while in maintenance: set a secret named PREVIEW_KEY
  // (Worker > Settings > Variables and Secrets), then visit https://lopezdemo.com/?preview=<that key>
  "vars": { "MAINTENANCE_MODE": "false" },
  "observability": { "enabled": true }
}
